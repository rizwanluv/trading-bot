# ==========================================
# Trading Bot Environment Configuration
# ==========================================

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_ALLOWED_USERS=

# AI / Gemini API Credentials
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Exchange Credentials (Binance)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_TESTNET=false

# Trading Mode: "paper" or "live"
TRADING_MODE=paper
INITIAL_PAPER_BALANCE=10000.0

# Risk Settings
DEFAULT_RISK_PER_TRADE_PCT=0.01
MIN_REWARD_TO_RISK=1.5
DEFAULT_ORDER_SIZE=1.0
MAX_OPEN_POSITIONS=3
MAX_DAILY_DRAWDOWN_PCT=0.05

# Server Port (for Railway / cloud hosting healthcheck)
PORT=8080
LOG_LEVEL=INFO
DEBUG=false
